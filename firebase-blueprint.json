{
  "entities": {
    "Items": {
      "title": "Items",
      "description": "Inventory items and stock tracking",
      "properties": {
        "legacy_ids": { "type": "string", "description": "Legacy ID or SKU tag" },
        "common_name": { "type": "string", "description": "Common name of the item" },
        "description": { "type": "string", "description": "Detailed item description" },
        "storage_location": { "type": "string", "description": "Warehouse shelf or bin location" },
        "stock_quantity": { "type": "number", "description": "Current stock quantity available" },
        "category": { "type": "string", "description": "Item category" },
        "unit": { "type": "string", "description": "Unit of measure (e.g., pcs, boxes, meters, sets)" },
        "min_stock": { "type": "number", "description": "Minimum reorder threshold" },
        "createdAt": { "type": "string", "description": "Creation ISO date" },
        "updatedAt": { "type": "string", "description": "Last modified ISO date" }
      },
      "required": ["common_name", "storage_location", "stock_quantity"]
    },
    "Orders": {
      "title": "Orders",
      "description": "Material request pick lists assigned to job numbers",
      "properties": {
        "jobNumber": { "type": "string", "description": "Job Number assigned to the order" },
        "status": { "type": "string", "description": "Fulfillment status: pending, in-progress, completed, cancelled" },
        "items": { "type": "array", "description": "List of requested items, stock IDs, common names, and quantities" },
        "notes": { "type": "string", "description": "Notes or special instructions" },
        "priority": { "type": "string", "description": "Order priority level (low, normal, high, urgent)" },
        "createdByUid": { "type": "string", "description": "Firebase user UID of manager" },
        "createdByName": { "type": "string", "description": "Name or email of manager" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of status update" }
      },
      "required": ["jobNumber", "status", "items", "createdAt"]
    }
  }
}
